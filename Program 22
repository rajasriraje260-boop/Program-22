class Stack:
    def __init__(self):
        self.items = []

    def push(self, item):
        self.items.append(item)

    def pop(self):
        return self.items.pop()

def evaluate_postfix(expression):
    stack = Stack()

    for ch in expression:
        if ch.isdigit():
            stack.push(int(ch))
        else:
            b = stack.pop()
            a = stack.pop()

            if ch == '+':
                stack.push(a + b)
            elif ch == '-':
                stack.push(a - b)
            elif ch == '*':
                stack.push(a * b)
            elif ch == '/':
                stack.push(a / b)

    return stack.pop()


exp = "23*54*+9-"

result = evaluate_postfix(exp)

print("Postfix Expression:", exp)
